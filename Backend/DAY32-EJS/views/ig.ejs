<!-- Templates Inside Template means Subtemplate.so we can use subtemplate like this -->

<%- include("includes/head.ejs") %>
<body>
    
    <h2> This page belong to @<%= data.name %> </h2>

    <button>Follow</button>
    <button>Message</button>

    <!-- Data fetching from database i.e data.json file -->

    <p>Followers: <%= data.followers %> &nbsp; &nbsp; &nbsp; Following: <%= data.following %></p>

    <!-- Loops in ejs -->

    <% for(post of data.posts){ %>

        <img src="<%= post.image %>" alt="some image"/>

        <p>Likes: <%= post.likes %> &nbsp; &nbsp; &nbsp; Comments: <%= post.comments %></p>

    <%} %>

    <%- include("includes/footer.ejs") %>

</body>
</html>

