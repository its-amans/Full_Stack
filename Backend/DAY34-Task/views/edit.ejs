<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Post</title>
</head>
<body>  
        <h1>@<%= post.username %></h1>
        <h3>Post id: @<%= post.id %></h3>
        <form method="POST" action="/posts/<%=post.id%>?_method=PATCH" enctype="multipart/form-data">
            <input type="file" name="img" accept="image/*" /><br><br>
            <textarea name="content"><%= post.content %></textarea><br><br>
            <button type="submit">Edit Post</button>
        </form>
</body>
</html>