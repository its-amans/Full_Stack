<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quora Posts</title>
    <link rel="stylesheet" href="style.css" class="css">
</head>
<body>
    <h1>Quora</h1>
    <% for(let post of posts){ %>
        <div class="posts">
            <h3 class="user">@<%= post.username %></h3>
            <h3 class="content"> <%= post.content %></h3>
  
            </br>

            <a href="http://localhost:8080/posts/<%= post.id %>"> Veiw Detailed Post</a>

            <a href="http://localhost:8080/posts/<%= post.id %>/edit"> Edit Post</a>

            </br>
            </br>
            <form method="post" action="posts/<%= post.id %>?_method=DELETE">
                <button type="submit">Delete Post</button>
            </form>

        </div>
    <% } %>

    </br></br>

    <a href="http://localhost:8080/posts/new"> Create new Posts</a>

    
</body>
</html>
